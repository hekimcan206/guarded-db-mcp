# Copy to .env to override the docker compose defaults. Defaults are for the local synthetic demo only.
MCP_PORT=18080
MCP_ORACLE_PORT=18081
POSTGRES_PORT=25542
ORACLE_PORT=25522
POSTGRES_PASSWORD=postgres-dev-only
ORACLE_PASSWORD=sys-dev-only
OWNER_PASSWORD=OwnerDev1
READER_PASSWORD=ReaderDev1
AUDIT_WRITER_PASSWORD=AuditWriterDev1
AUDITOR_PASSWORD=AuditorDev1

# Base64, at least 32 bytes. Generate your own: openssl rand -base64 32
PSEUDONYM_KEY=Y29tcG9zZS1kZW1vLXBzZXVkb255bS1rZXktbm90LWZvci1yZWFsLWRhdGE=

# Bearer key the demo agent sends, and the SHA-256 the server is configured with:
#   printf '%s' "$AGENT_KEY" | sha256sum
AGENT_KEY=demo-clinic1-key-not-for-production
AGENT_KEY_SHA256=206dbca3d511754ade5d7d319485010469f389c4a982110912fa5bbf70a600e8

# Set to export traces/metrics to an OTLP collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
