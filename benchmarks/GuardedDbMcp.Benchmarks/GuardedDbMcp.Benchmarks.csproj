<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- BenchmarkDotNet generates code that does not follow the repository analyzers. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1515;CA1822;CA1050;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GuardedDbMcp.Core\GuardedDbMcp.Core.csproj" />
    <ProjectReference Include="..\..\src\GuardedDbMcp.Demo\GuardedDbMcp.Demo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\policy.json" Link="policy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
