{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol": "Warning"
    }
  },
  "GuardedDb": {
    "Engine": "postgres",
    "Audit": { "Sink": "Jsonl", "Path": "guarded-db-mcp-audit.jsonl" },
    "Presidio": { "FailureMode": "Closed", "ScoreThreshold": 0.5 }
  }
}
